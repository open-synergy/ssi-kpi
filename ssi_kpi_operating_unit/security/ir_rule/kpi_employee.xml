<odoo>
<record id="kpi_employee_rule_ou" model="ir.rule">
    <field name="name">KPI Employee - Responsible to operating unit data</field>
    <field name="model_id" ref="ssi_kpi.model_kpi_employee" />
    <field name="groups" eval="[(4, ref('kpi_employee_ou_group'))]" />
    <field
            name="domain_force"
        >[('operating_unit_id','in',[g.id for g in user.operating_unit_ids])]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>

<record id="kpi_employee_appraisal_rule_ou" model="ir.rule">
    <field name="name">KPI Employee Appraisal - Responsible to operating unit data</field>
    <field name="model_id" ref="ssi_kpi.model_kpi_employee_appraisal" />
    <field name="groups" eval="[(4, ref('kpi_employee_appraisal_ou_group'))]" />
    <field
            name="domain_force"
        >[('operating_unit_id','in',[g.id for g in user.operating_unit_ids])]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>
</odoo>
