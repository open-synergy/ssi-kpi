<odoo>
<!-- KPI EMPLOYEE -->
<record id="kpi_employee_view_tree" model="ir.ui.view">
    <field name="name">kpi.employee tree - operating unit</field>
    <field name="model">kpi.employee</field>
    <field name="inherit_id" ref="ssi_kpi.kpi_employee_view_tree" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                        optional="hide"
                    />
            </xpath>
        </data>
    </field>
</record>

<record id="kpi_employee_view_search" model="ir.ui.view">
    <field name="name">kpi.employee search - operating unit</field>
    <field name="model">kpi.employee</field>
    <field name="inherit_id" ref="ssi_kpi.kpi_employee_view_search" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
            <xpath expr="//filter[@name='grp_company']" position="after">
                <filter
                        name="grp_ou"
                        string="Operating Unit"
                        context="{'group_by':'operating_unit_id'}"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
        </data>
    </field>
</record>

<record id="kpi_employee_view_form" model="ir.ui.view">
    <field name="name">kpi.employee form - operating unit</field>
    <field name="model">kpi.employee</field>
    <field name="inherit_id" ref="ssi_kpi.kpi_employee_view_form" />
